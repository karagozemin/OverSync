{
  "name": "@oversync/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the OverSync cross-chain bridge: Ethereum + Soroban HTLC clients, secret utilities, and a shared order state machine.",
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ethereum": {
      "types": "./src/ethereum/index.ts",
      "import": "./src/ethereum/index.ts",
      "default": "./src/ethereum/index.ts"
    },
    "./soroban": {
      "types": "./src/soroban/index.ts",
      "import": "./src/soroban/index.ts",
      "default": "./src/soroban/index.ts"
    },
    "./secrets": {
      "types": "./src/secrets/index.ts",
      "import": "./src/secrets/index.ts",
      "default": "./src/secrets/index.ts"
    },
    "./state-machine": {
      "types": "./src/state-machine/index.ts",
      "import": "./src/state-machine/index.ts",
      "default": "./src/state-machine/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^13.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
